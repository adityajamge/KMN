# The server reads KMN/backend/.env, not this file.
# Copy these lines into .env if it is missing, then paste the Neon URL there.
# It looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# This API uses 4001 so it does not clash with the Shadanga Kriya app on 4000.
PORT=4001

# The event website. Add the live site later, separated by commas.
ALLOWED_ORIGINS=http://localhost:5174

# Optional. When this is set, the event desk must send it as the x-admin-key header.
# Leave it empty while you are working on this computer.
ADMIN_KEY=

# Razorpay test keys from the dashboard: Account & Settings, then API Keys.
# The server accepts only a test key (rzp_test_). Paste the real values into .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional until the API is on a public HTTPS address. Razorpay sends this with payment webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API. From Meta Business Suite: WhatsApp, then API setup.
# Phone number ID is the id shown there, not the mobile number itself.
# Leave these empty until the business account and templates are approved.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
PUBLIC_SITE_URL=http://localhost:5174
WHATSAPP_WELCOME_VIDEO_URL=
